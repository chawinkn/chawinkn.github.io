---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = "Chawin Chaisongkram",
  description = "Chawin Chaisongkram (Kanoon) Computer Engineering Student",
  image = "/og-image.png",
  type = "website",
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://chawinkn.com");
const canonicalURL = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ""), siteUrl);

const pageTitle = Astro.url.pathname === "/" ? "Chawin Chaisongkram" : `Kanoon | ${title}`;
const ogImage = new URL(image, siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}#person`,
      name: "Chawin Chaisongkram",
      alternateName: ["Kanoon", "chawinkn"],
      url: siteUrl.toString(),
      sameAs: [
        "https://github.com/chawinkn",
        "https://www.linkedin.com/in/chawinkn",
        "https://instagram.com/chawinkn",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl.toString(),
      name: "chawinkn",
      description: description,
      publisher: { "@id": `${siteUrl}#person` },
    },
  ],
};
---

<!doctype html>
<html lang="en" style="background-color: #F2F0EF;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#F2F0EF" />
    <style is:inline>
      html,
      body {
        background-color: #f2f0ef;
      }
    </style>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Chawin Chaisongkram (Kanoon)" />
    <meta name="keywords" content="Chawin Chaisongkram, Kanoon, chawinkn" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="eoeJQCJP5jWFPGgqBbyjQY-5T6WUYYLlXUk7zG3hKOg" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:site_name" content="Chawin Chaisongkram (Kanoon)" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@chawinkn" />
    <meta name="twitter:creator" content="@chawinkn" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&family=IBM+Plex+Serif+Thai:wght@300;400;500;600;700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,300..700;1,300..700&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background text-foreground antialiased">
    <main class="container-content pt-6 md:pt-8 pb-8 md:pb-10">
      <Header />
      <slot />
      <Footer />
    </main>
  </body>
</html>
