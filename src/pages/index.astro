---
import Layout from "../layouts/Layout.astro";
import PictureFigure from "../components/PictureFigure.astro";

const accessKey = import.meta.env.UNSPLASH_ACCESS_KEY;

const week = Math.floor((Date.now() + 7 * 36e5 - 4 * 864e5) / (7 * 864e5));

const photos = accessKey
  ? await fetch(
      `https://api.unsplash.com/search/photos?per_page=21&page=${(week % 400) + 1}&query=city,travel,architecture&orientation=landscape`,
      { headers: { Authorization: `Client-ID ${accessKey}` } }
    )
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        const list: any[] = data?.results ?? [];
        return list.map((item) => ({
          img: item.urls?.regular ?? "",
          url: item.links?.html ?? "",
          title: item.location?.name ?? "",
          alt: item.alt_description ?? item.description ?? "",
          shortDescription: item.short_description ?? item.description ?? "",
          author: item.user?.name ? `photo by ${item.user.name}` : "",
        }));
      })
      .catch((e) => {
        console.error("Failed to fetch weekly photos from Unsplash:", e);
        return [];
      })
  : [];

const initialPhoto = photos[0];
---

<Layout title="Chawin Chaisongkram">
  <section class="mt-8 mb-6 space-y-8">
    <div class="space-y-6 text-base md:text-lg leading-relaxed">
      <p class="text-foreground">Hi! I'm Kanoon. - in progress</p>

      <div class="flex flex-col gap-2 font-mono text-sm">
        <a
          href="/cv.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link underline underline-offset-4 w-fit hover:opacity-70"
        >
          -&gt; curriculum vitae
        </a>
        <a href="/projects" class="text-link underline underline-offset-4 w-fit hover:opacity-70">
          -&gt; projects
        </a>
        <a href="/music" class="text-link underline underline-offset-4 w-fit hover:opacity-70">
          -&gt; music
        </a>
        <a href="/blogs" class="text-link underline underline-offset-4 w-fit hover:opacity-70">
          -&gt; blogs
        </a>
      </div>
    </div>

    {initialPhoto && (
      <PictureFigure
        linkId="daily-photo-link"
        imgId="daily-photo-img"
        titleId="daily-photo-title"
        subtitleId="daily-photo-subtitle"
        quoteId="daily-photo-quote"
        url={initialPhoto.url}
        img={initialPhoto.img}
        alt={initialPhoto.alt}
        title={initialPhoto.title}
        subtitle={initialPhoto.author}
        quote={initialPhoto.shortDescription}
      />
    )}
  </section>

  <script is:inline define:vars={{ photos }}>
    if (photos.length) {
      const now = new Date(Date.now() + 7 * 36e5);
      const slot = ((now.getUTCDay() + 6) % 7) * 3 + Math.floor(now.getUTCHours() / 8);
      const currentPhoto = photos[slot % photos.length];
      if (currentPhoto) {
        const linkEl = document.getElementById("daily-photo-link");
        const imgEl = document.getElementById("daily-photo-img");
        const titleEl = document.getElementById("daily-photo-title");
        const subtitleEl = document.getElementById("daily-photo-subtitle");
        const quoteEl = document.getElementById("daily-photo-quote");

        if (linkEl && currentPhoto.url) linkEl.href = currentPhoto.url;
        if (imgEl && currentPhoto.img) {
          imgEl.src = currentPhoto.img;
          imgEl.alt = currentPhoto.alt || currentPhoto.title || "";
        }
        if (titleEl) titleEl.textContent = currentPhoto.title || "";
        if (subtitleEl) subtitleEl.textContent = currentPhoto.author || "";
        if (quoteEl)
          quoteEl.textContent = currentPhoto.shortDescription
            ? `“${currentPhoto.shortDescription}”`
            : "";
      }
    }
  </script>
</Layout>
