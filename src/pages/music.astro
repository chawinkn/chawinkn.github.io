---
import Layout from "../layouts/Layout.astro";
import PictureFigure from "../components/PictureFigure.astro";
import rawMusicData from "../data/music.json";
import { getMeta, smallCover } from "../lib/music-meta";

interface Song {
  name: string;
  artist: string;
  album?: string;
  favoriteLyrics: string[];
  url: string;
}

const songs = [...(rawMusicData as Song[])].sort((a, b) => a.name.localeCompare(b.name));
const tiles = await Promise.all(songs.map(async (song) => ({ song, ...(await getMeta(song)) })));

const releaseMap = new Map<
  string,
  { release: (typeof tiles)[number]["release"]; cover: string | null; owned: Song[] }
>();
for (const { song, release, cover } of tiles) {
  const entry = releaseMap.get(release.id) ?? { release, cover, owned: [] };
  entry.cover ??= cover;
  entry.owned.push(song);
  releaseMap.set(release.id, entry);
}
const releases = [...releaseMap.values()].sort((a, b) =>
  a.release.name.localeCompare(b.release.name)
);

const defaultSong = songs[0];
const defaultLyric = defaultSong?.favoriteLyrics?.[0] || "";
const defaultVideoId = defaultSong?.url ? new URL(defaultSong.url).searchParams.get("v") : "";
const gridClass = "mt-4 grid grid-cols-1 gap-x-4 gap-y-5 sm:grid-cols-2 lg:grid-cols-3";
const modeClass =
  "underline underline-offset-4 aria-[pressed=false]:text-muted aria-[pressed=false]:no-underline";
---

<Layout
  title="music"
  description="Curated playlist of favorite songs, tracks, and memorable lyrics collected and enjoyed by Chawin Chaisongkram (Kanoon)."
>
  <section class="my-10 space-y-8">
    {defaultSong && defaultVideoId && (
      <PictureFigure
        linkId="today-song-link"
        imgId="today-song-img"
        titleId="random-song-name"
        quoteId="random-lyric-text"
        url={defaultSong.url}
        img={`https://i3.ytimg.com/vi/${defaultVideoId}/maxresdefault.jpg`}
        alt={defaultSong.name}
        title={defaultSong.name}
        quote={defaultLyric}
      />
    )}

    <section aria-labelledby="music-list-heading" class="pt-2">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h3 id="music-list-heading" class="font-mono text-sm text-foreground">
          music list
        </h3>
        <div class="flex flex-wrap items-center gap-4">
          <div
            class="flex items-center gap-2 font-mono text-xs text-foreground"
            role="group"
            aria-label="view mode"
          >
            <button type="button" data-mode="songs" aria-pressed="true" class={modeClass}>
              songs
            </button>
            <span class="text-muted">|</span>
            <button type="button" data-mode="releases" aria-pressed="false" class={modeClass}>
              releases
            </button>
          </div>
          <input
            id="music-search"
            type="search"
            placeholder="search..."
            autocomplete="off"
            class="bg-transparent font-mono text-xs text-foreground placeholder:text-muted outline-none border-b border-border focus:border-foreground py-0.5"
          />
          <label for="music-sort" class="font-mono text-xs text-foreground">
            sort by:
            <select
              id="music-sort"
              class="bg-transparent font-mono text-xs text-foreground underline underline-offset-4 outline-none"
            >
              <option value="name">name</option>
              <option value="artist">artist</option>
              <option value="album">album</option>
            </select>
          </label>
        </div>
      </div>
      <ul id="music-list-body" class={gridClass}>
        {tiles.map(({ song, cover }) => (
          <li
            data-name={song.name}
            data-artist={song.artist}
            data-album={song.album || ""}
            data-search={`${song.name} ${song.artist} ${song.album || ""}`.toLowerCase()}
          >
            <a
              href={song.url}
              target="_blank"
              rel="noreferrer"
              class="flex items-center gap-3 font-mono hover:opacity-70"
            >
              <div class="size-12 shrink-0 overflow-hidden bg-surface-muted">
                {cover && (
                  <img
                    src={smallCover(cover)}
                    alt={song.album ? `${song.album} cover` : `${song.name} cover`}
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                    class="size-full object-cover"
                  />
                )}
              </div>
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-foreground">{song.name}</p>
                <p class="truncate text-xs text-muted">{song.artist}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <ul id="release-list" class="mt-4 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-4" hidden>
        {releases.map(({ release, cover, owned }) => (
          <li
            data-name={release.name}
            data-artist={owned[0].artist}
            data-album={release.name}
            data-search={`${release.name} ${owned[0].artist} ${owned.map((s) => s.name).join(" ")}`.toLowerCase()}
          >
            <div class="font-mono">
              <div class="aspect-square w-full overflow-hidden bg-surface-muted">
                {cover && (
                  <img
                    src={cover}
                    alt={`${release.name} cover`}
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="size-full object-cover"
                  />
                )}
              </div>
              <p class="mt-2 text-sm font-medium text-foreground">{release.name}</p>
            </div>
          </li>
        ))}
      </ul>
      <p id="music-empty" class="py-8 text-center font-mono text-sm text-muted" hidden>
        no songs found
      </p>
    </section>
  </section>

  <script is:inline define:vars={{ songs }}>
    if (songs.length > 0) {
      const slot = Math.floor((Date.now() + 7 * 3600000) / 43200000);
      const pick = (n, salt) => (Math.imul(slot + salt, 2654435761) >>> 0) % n;
      const randomSong = songs[pick(songs.length, 0)];

      const videoId = new URL(randomSong.url).searchParams.get("v");
      const songLinkEl = document.getElementById("today-song-link");
      const songImgEl = document.getElementById("today-song-img");
      const lyricEl = document.getElementById("random-lyric-text");
      const songNameEl = document.getElementById("random-song-name");
      const lyrics = randomSong.favoriteLyrics || [];
      const randomLyric = lyrics[pick(lyrics.length, 1)];

      if (songLinkEl && videoId) {
        songLinkEl.href = randomSong.url;
        songLinkEl.setAttribute("aria-label", `Listen to ${randomSong.name} on YouTube`);
        if (songImgEl) {
          songImgEl.onerror = () => {
            songImgEl.onerror = null;
            songImgEl.src = `https://i3.ytimg.com/vi/${videoId}/hqdefault.jpg`;
          };
          songImgEl.src = `https://i3.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
          songImgEl.alt = randomSong.name;
        }
      }

      if (songNameEl) {
        songNameEl.textContent = randomSong.name;
      }

      if (lyricEl) {
        lyricEl.textContent = randomLyric ? `“${randomLyric}”` : "";
      }

      const musicSortEl = document.getElementById("music-sort");
      const musicSearchEl = document.getElementById("music-search");
      const emptyRowEl = document.getElementById("music-empty");
      const lists = {
        songs: document.getElementById("music-list-body"),
        releases: document.getElementById("release-list"),
      };
      const modeButtons = [...document.querySelectorAll("[data-mode]")];
      let mode = "songs";

      const rowsOf = () => [...lists[mode].querySelectorAll(":scope > li")];

      const filterRows = () => {
        const q = musicSearchEl ? musicSearchEl.value.trim().toLowerCase() : "";
        let visible = 0;
        rowsOf().forEach((row) => {
          const match = !q || row.dataset.search.includes(q);
          row.hidden = !match;
          if (match) visible++;
        });
        if (emptyRowEl) {
          emptyRowEl.hidden = visible > 0;
        }
      };

      const sortRows = () => {
        const sortKey = musicSortEl ? musicSortEl.value : "name";
        const rows = rowsOf().sort((a, b) =>
          (a.dataset[sortKey] || "").localeCompare(b.dataset[sortKey] || "")
        );
        lists[mode].prepend(...rows);
      };

      if (musicSearchEl) {
        musicSearchEl.addEventListener("input", filterRows);
      }

      if (musicSortEl) {
        musicSortEl.addEventListener("change", sortRows);
      }

      modeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          mode = button.dataset.mode;
          Object.entries(lists).forEach(([key, el]) => (el.hidden = key !== mode));
          modeButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
          sortRows();
          filterRows();
        });
      });
    }
  </script>
</Layout>
