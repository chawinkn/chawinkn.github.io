---
import Layout from "../layouts/Layout.astro";
import PictureFigure from "../components/PictureFigure.astro";
import rawMusicData from "../data/music.json";

interface Song {
  name: string;
  artist: string;
  album?: string;
  favoriteLyrics: string[];
  url: string;
}

const songs = [...(rawMusicData as Song[])].sort((a, b) => a.name.localeCompare(b.name));
const cache: Map<string, string> = ((globalThis as any).__musicCovers ??= new Map());

const mainArtist = (artist: string) =>
  artist
    .split(/\s+(?:ft\.?|feat\.?|&)\s+|,/i)[0]
    .trim()
    .toLowerCase();

async function fetchOk(url: string, init: RequestInit = {}) {
  for (let attempt = 0; attempt < 3; attempt++) {
    if (attempt) await new Promise((r) => setTimeout(r, 1500));
    const res = await fetch(url, { ...init, signal: AbortSignal.timeout(10000) }).catch(() => null);
    if (res?.ok) return res;
  }
  return null;
}

async function itunesCover(song: Song): Promise<string | null> {
  const term = encodeURIComponent(`${song.name} ${song.artist}`);
  const res = await fetchOk(`https://itunes.apple.com/search?entity=song&limit=5&term=${term}`);
  if (!res) return null;
  const { results = [] } = await res.json();
  const artist = mainArtist(song.artist);
  const byArtist = results.filter((r: any) => r.artistName?.toLowerCase().includes(artist));
  const hit = byArtist.find((r: any) => r.collectionName === song.album) ?? byArtist[0];
  return hit?.artworkUrl100?.replace("100x100bb", "600x600bb") ?? null;
}

let musicBrainzQueue: Promise<unknown> = Promise.resolve();

function musicBrainzCover(song: Song): Promise<string | null> {
  const artist = mainArtist(song.artist);
  const title = (song.album || song.name).replace(/"/g, "");
  const query = encodeURIComponent(`release:"${title}" AND artist:"${artist.replace(/"/g, "")}"`);
  const run = musicBrainzQueue.then(async () => {
    const res = await fetchOk(
      `https://musicbrainz.org/ws/2/release/?fmt=json&limit=5&query=${query}`,
      {
        headers: { "User-Agent": "chawinkn.com/1.0 (https://chawinkn.com)" },
      }
    );
    if (!res) return null;
    const { releases = [] } = await res.json();
    const matches = releases.filter((r: any) =>
      r["artist-credit"]?.some((a: any) => a.name?.toLowerCase().includes(artist))
    );
    for (const release of matches.slice(0, 3)) {
      const url = `https://coverartarchive.org/release/${release.id}/front-500`;
      if (await fetchOk(url, { method: "HEAD" })) return url;
    }
    return null;
  });
  musicBrainzQueue = run.catch(() => {}).then(() => new Promise((r) => setTimeout(r, 1100)));
  return run;
}

async function getCover(song: Song) {
  const key = `${song.name}|${song.artist}`;
  const cached = cache.get(key);
  if (cached) return cached;
  const cover =
    (await itunesCover(song).catch(() => null)) ?? (await musicBrainzCover(song).catch(() => null));
  if (cover) cache.set(key, cover);
  return cover;
}

const tiles = await Promise.all(songs.map(async (song) => ({ song, cover: await getCover(song) })));
const defaultSong = songs[0];
const defaultLyric = defaultSong?.favoriteLyrics?.[0] || "";
const defaultVideoId = defaultSong?.url ? new URL(defaultSong.url).searchParams.get("v") : "";
---

<Layout
  title="music"
  description="Curated playlist of favorite songs, tracks, and memorable lyrics collected and enjoyed by Chawin Chaisongkram (Kanoon)."
>
  <section class="my-10 space-y-8">
    {defaultSong && defaultVideoId && (
      <PictureFigure
        linkId="today-song-link"
        imgId="today-song-img"
        titleId="random-song-name"
        quoteId="random-lyric-text"
        url={defaultSong.url}
        img={`https://i3.ytimg.com/vi/${defaultVideoId}/maxresdefault.jpg`}
        alt={defaultSong.name}
        title={defaultSong.name}
        quote={defaultLyric}
      />
    )}

    <section aria-labelledby="music-list-heading" class="pt-2">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h3 id="music-list-heading" class="font-mono text-sm text-foreground">
          music list
        </h3>
        <div class="flex flex-wrap items-center gap-4">
          <input
            id="music-search"
            type="search"
            placeholder="search..."
            autocomplete="off"
            class="bg-transparent font-mono text-xs text-foreground placeholder:text-muted outline-none border-b border-border focus:border-foreground py-0.5"
          />
          <label for="music-sort" class="font-mono text-xs text-foreground">
            sort by:
            <select
              id="music-sort"
              class="bg-transparent font-mono text-xs text-foreground underline underline-offset-4 outline-none"
            >
              <option value="name">name</option>
              <option value="artist">artist</option>
              <option value="album">album</option>
            </select>
          </label>
        </div>
      </div>
      <ul id="music-list-body" class="mt-4 grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-5">
        {tiles.map(({ song, cover }) => (
          <li data-name={song.name} data-artist={song.artist} data-album={song.album || ""}>
            <a
              href={song.url}
              target="_blank"
              rel="noreferrer"
              class="block font-mono hover:opacity-70"
            >
              <div class="aspect-square w-full overflow-hidden bg-surface-muted">
                {cover && (
                  <img
                    src={cover}
                    alt={song.album ? `${song.album} cover` : `${song.name} cover`}
                    width="600"
                    height="600"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                )}
              </div>
              <p class="mt-2 text-sm font-medium text-foreground">{song.name}</p>
              <p class="text-xs text-muted">{song.artist}</p>
            </a>
          </li>
        ))}
      </ul>
      <p id="music-empty" class="py-8 text-center font-mono text-sm text-muted" hidden>
        no songs found
      </p>
    </section>
  </section>

  <script is:inline define:vars={{ songs }}>
    if (songs.length > 0) {
      const slot = Math.floor((Date.now() + 7 * 3600000) / 43200000);
      const pick = (n, salt) => (Math.imul(slot + salt, 2654435761) >>> 0) % n;
      const randomSong = songs[pick(songs.length, 0)];

      const videoId = new URL(randomSong.url).searchParams.get("v");
      const songLinkEl = document.getElementById("today-song-link");
      const songImgEl = document.getElementById("today-song-img");
      const lyricEl = document.getElementById("random-lyric-text");
      const songNameEl = document.getElementById("random-song-name");
      const lyrics = randomSong.favoriteLyrics || [];
      const randomLyric = lyrics[pick(lyrics.length, 1)];

      if (songLinkEl && videoId) {
        songLinkEl.href = randomSong.url;
        songLinkEl.setAttribute("aria-label", `Listen to ${randomSong.name} on YouTube`);
        if (songImgEl) {
          songImgEl.onerror = () => {
            songImgEl.onerror = null;
            songImgEl.src = `https://i3.ytimg.com/vi/${videoId}/hqdefault.jpg`;
          };
          songImgEl.src = `https://i3.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
          songImgEl.alt = randomSong.name;
        }
      }

      if (songNameEl) {
        songNameEl.textContent = randomSong.name;
      }

      if (lyricEl) {
        lyricEl.textContent = randomLyric ? `“${randomLyric}”` : "";
      }

      const musicSortEl = document.getElementById("music-sort");
      const musicSearchEl = document.getElementById("music-search");
      const musicListBodyEl = document.getElementById("music-list-body");
      const emptyRowEl = document.getElementById("music-empty");

      if (musicListBodyEl) {
        const rows = [...musicListBodyEl.querySelectorAll("li")];

        const filterRows = () => {
          const q = musicSearchEl ? musicSearchEl.value.trim().toLowerCase() : "";
          let visible = 0;
          rows.forEach((row) => {
            const text =
              `${row.dataset.name || ""} ${row.dataset.artist || ""} ${row.dataset.album || ""}`.toLowerCase();
            const match = !q || text.includes(q);
            row.hidden = !match;
            if (match) visible++;
          });
          if (emptyRowEl) {
            emptyRowEl.hidden = visible > 0;
          }
        };

        if (musicSearchEl) {
          musicSearchEl.addEventListener("input", filterRows);
        }

        if (musicSortEl) {
          musicSortEl.addEventListener("change", () => {
            const sortKey = musicSortEl.value;
            rows.sort((a, b) => (a.dataset[sortKey] || "").localeCompare(b.dataset[sortKey] || ""));
            musicListBodyEl.prepend(...rows);
          });
        }
      }
    }
  </script>
</Layout>
