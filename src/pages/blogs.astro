---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";
---

<Layout
	title="chawinkn - blogs"
	description="Writings, essays, and notes by Chawin Chaisongkram (Kanoon)."
>
	<section class="my-10 space-y-6">
		<div>
			<BackLink />
			<h2 class="text-xl md:text-2xl font-semibold tracking-tight mb-2">
				Blogs / บทความ
			</h2>
			<p class="text-muted text-sm font-mono">
				writing, essays, and notes
			</p>
		</div>

		<p class="text-base text-muted-foreground">
			No posts yet. Writing in progress.
		</p>
	</section>
</Layout>
